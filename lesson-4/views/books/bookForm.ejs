<%- include('../components/html-top') -%>
<%- include('../components/header', {activePage: 'form'}) -%>
    <h1><%= book.id ? 'Update the book' : 'Add new book' %></h1>
    <form action="<%= book.id ? '/update-book/' + book.id : '/create-book' %>" method="post">
        <label>
            Title
            <input type="text" placeholder="Title of the book" name="title" value="<%= book.title %>">
        </label>
        <label>
            Author
            <input type="text" placeholder="Author of the book" name="author" value="<%= book.author %>">
        </label>
        <label>
            Issue Date
            <input type="date" placeholder="Date of issue" name="year" value="<%= book.year %>">
        </label>
        <button><%= book.id ? 'Update' : 'Add' %></button>
       <a href="<%= backUrl %>">Cancel</a>
    </form>
<%- include('../components/html-btm') -%>