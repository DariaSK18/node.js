<%- include('../components/html-top') -%>
<%- include('../components/header', {activePage: 'books'}) -%>
<main class="container">
        <h1 class="main-title">Books list</h1>
        <form method="get" class="form-search">
            Filters: 
                <input type="text" name="title" placeholder="Search a book by title">
                <input type="number" min="868" name="year" placeholder="Year filter">
            <button class="card-btn" type="submit">Apply</button>
        </form>
        <% if(books.length === 0) { %>
            <p>No books were found!</p>
            <% } %>
        <div class="book-list">
        <% books.forEach(book => { %>
            <div class="book-card">
                <h3 class="book-title"><a href='/book/<%= book.id %>'> <%= book.title %></a></h3>
                <p>by <%= book.author %></p>
                <p><%= book.year %> year</p>
                <div class="card-btns">
                    <a href='/update-book/<%= book.id %>'><button class="card-btn">Edit</button></a>
                    <button class="card-btn btn-del" onclick="deleteBook('<%= book.id %>')">Delete</button>
                </div>
            </div>
        <% }) %>
    </div>
</main>
<%- include('../components/html-btm') -%>