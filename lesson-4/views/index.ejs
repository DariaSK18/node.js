<%- include('components/header', {activePage: 'home'}) -%>
<main class="container">
        <h1 class="main-title">My book tracker</h1>
        <h4>A simple place to keep your reading life in order.</h4>
        <section>
            <ul>
                <li>Keep track of books you’ve read</li>
                <li>Remember your favourite stories</li>
                <li>Plan what to read next</li>
            </ul>
        </section>
        <section class="about-philosophy">
