<%- include('../components/html-top') -%>
<%- include('../components/header', {activePage: 'cars'}) -%>
<main class="container">
        <h1 class="main-title">
Welcome to AutoTrade</h1>
        <section>
            <form method="get" class="form form-filter">
                <strong>Filters:</strong>
                <div class="filters">
                    <div>
                        <% if(errors?.length !== 0) { %>
                            <ul class="errors">
                                <% errors.forEach(err => { %>
                                    <li><%= err.msg %></li>
                                <% }) %>
                            </ul>
                        <% } %>
                    </div>
                    <div class="filters__inputs">
                        <select name="make" id="makeSelect">
                            <option value="all" selected>All cars</option>
                            <% const makes = new Set()
                            cars.forEach(car => makes.add(car.make)) %>
                            <% makes.forEach(make => { %>
                                <option value="<%= make %>"><%= make %></option>
                            <% }) %>
                        </select>
                        <input type="number" name="minYear" placeholder="Min year">
                        <input type="number" name="maxYear" placeholder="Max year">
                        <input type="number" name="price" placeholder="Max price">
                    </div>
                    <div class="filters__fieldset">
                        <fieldset>
                            <legend>Choose your fuel type:</legend>
                            <label>
                                <input type="checkbox" name="fuelType" value="petrol">
                                Petrol
                            </label>
                            <label>
                                <input type="checkbox" name="fuelType" value="diesel">
                                Diesel
                            </label>
                            <label>
                                <input type="checkbox" name="fuelType" value="electric">
                                Electric
                            </label>
                        </fieldset>
                        <button type="submit" class="btn">Apply</button>
                    </div>
                </div>
            </form>
        </section>
        <section>
            <h3>Featured Stock</h3>
        <div class="cards-container">
            <% filteredList.forEach(car => { %>
                    <div class="card">
                         <div class="swiper mySwiper swiper-list">
    <div class="swiper-wrapper">
        <% if (car.images && car.images.length) { %>
      <% car.images.forEach(img => { %>
      <div class="swiper-slide"><img src="<%= `/${img}` %>" alt="car"></div>
     <% }) %>
      <% } else { %>
        <div class="img-wrapper"><img src="/images/no-photo-car.jpg" alt="Car"></div>
        <% } %>
    </div>
    <div class="swiper-button-next"></div>
    <div class="swiper-button-prev"></div>
    <div class="swiper-pagination"></div>
  </div>
                        <div class="card__content">
                            <h3><%= car.make %></h3>
                            <div class="card__car">
                                <h4><%= car.model %></h4>
                                <p><%= car.regPlate %></p>
                            </div>
                            <p class="card__description"><%= car.description %></p>
                            <div class="card__details">
                                <% if(car.year) { %>
                                <div><%= car.year %></div>
                                <% } %>
                                <% if(car.mileage) { %>
                                <div><%= car.mileage %></div>
                                <% } %>
                                <% if(car.fuelType) { %>
                                <div><%= car.fuelType %></div>
                                <% } %>
                                <% if(car.color) { %>
                                <div><%= car.color %></div>
                                <% } %>
                            </div>
                            <div>$ <%= car.price %></div>
                            <div class="card__btns">
                                <a href='/update-car/<%= car.id %>' class="btn-edit"><button>Edit</button></a>
                                <button class="btn-del" onclick="deleteCar('<%= car.id %>')">Delete</button>
                            </div>
                            <a href='/car/<%= car.id %>' class="btn">View this vehicle</a>
                        </div>
                    </div>
            <% }) %>
        </div>
        </section>
        <section>
            <% if(filteredList.length === 0) { %>
            <h3>No cars were found!</h3>
            <% } %>
        </section>
</main>
<%- include('../components/html-btm') -%>