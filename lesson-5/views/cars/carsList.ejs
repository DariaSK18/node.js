<%- include('../components/html-top') -%>
<%- include('../components/header', {activePage: 'cars'}) -%>
<main class="container">
        <h1 class="main-title">
Welcome to AutoTrade</h1>
        <section>
            <form method="get" class="form form-filter">
                <strong>Filters:</strong>
                <div class="filters">
                    <div class="filters__inputs">
                        <select name="make" id="makeSelect">
                            <option value="all" selected>All cars</option>
                            <% cars.forEach(car => { %>
                                <option value="<%= car.make %>"><%= car.make %></option>
                            <% }) %>
                        </select>
                        <input type="number" min="1700" max="<%= maxYear %>" name="minYear" placeholder="Min year">
                        <input type="number" min="1700" max="<%= maxYear %>" name="maxYear" placeholder="Max year">
                        <input type="number" min="0" max="1000000000" name="price" placeholder="Max price">
                    </div>
                    <div class="filters__fieldset">
                        <fieldset>
                            <legend>Choose your fuel type:</legend>
                            <label>
                                <input type="checkbox" name="fuelType" value="petrol">
                                Petrol
                            </label>
                            <label>
                                <input type="checkbox" name="fuelType" value="diesel">
                                Diesel
                            </label>
                            <label>
                                <input type="checkbox" name="fuelType" value="electric">
                                Electric
                            </label>
                        </fieldset>
                        <button type="submit" class="btn">Apply</button>
                    </div>
                </div>
            </form>
        </section>
        <section>
            <h3>Featured Stock</h3>
        <div class="cards-container">
            <% filteredList.forEach(car => { %>
                    <div class="card">
                        <img src="<%= car.images ? car.images[0] : '/images/no-photo-car.jpg '%>" alt="Car" style="height: 160px">
                        <p class="card__img-count"><%= car.images?.length > 0 ? `1/${car.images.length}` : 0 %></p>
                        <div class="card__content">
                            <h3><%= car.make %></h3>
                            <div class="card__car">
                                <h4><%= car.model %></h4>
                                <p><%= car.regPlate %></p>
                            </div>
                            <p class="card__description"><%= car.description %></p>
                            <div class="card__details">
                                <div><%= car.year %></div>
                                <div><%= car.mileage %></div>
                                <div><%= car.fuelType %></div>
                                <div><%= car.color %></div>
                            </div>
                            <div>$ <%= car.price %></div>
                            <div class="card__btns">
                                <a href='/update-car/<%= car.id %>' class="btn-edit"><button>Edit</button></a>
                                <button class="btn-del" onclick="deleteCar('<%= car.id %>')">Delete</button>
                            </div>
                            <a href='/car/<%= car.id %>' class="btn">View this vehicle</a>
                        </div>
                    </div>
            <% }) %>
        </div>
        </section>
        <section>
            <% if(filteredList.length === 0) { %>
            <h3>No cars were found!</h3>
            <% } %>
        </section>
</main>
<%- include('../components/html-btm') -%>